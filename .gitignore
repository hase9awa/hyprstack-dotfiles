# Personal configuration and required assets.
/*
!/.gitignore
!/.gitattributes
!/LICENSE
!/README.md
!/README.en.md
!/home/
!/system/
!/assets/
!/packages/

# Credentials, histories, build products and temporary session data.
**/.git/
**/.codex/
**/AGENTS.md
**/PROMPT.md
**/PROMPTS.md
**/SKILL.md
**/.ssh/
**/.gnupg/
**/keyrings/
**/kwalletd/
**/kwalletd5/
**/kwalletd6/
**/credentials*
**/*api-key*
**/*api_key*
**/*secret*
**/Cookies*
**/Login Data*
**/History*
**/*_history
**/.bash_history
**/.zsh_history
**/fish_history
**/notifs.json
**/apps.sqlite*
**/app-cache.json
**/gpu-performance.json
**/brightness.lock
**/icon-theme.cache
**/__pycache__/
**/node_modules/
**/build/
**/backups/
**/retired/
*.py[cod]
*.so
*.so.*
*.o
*.a
*.log
*.jsonl
*.tmp
*.bak
*.bak.*
*.pem
*.key
*.p12
*.pfx

# The only browser setting in this snapshot is its launch flags.
/home/.config/thorium/*
!/home/.config/thorium/thorium-flags.conf
/home/.config/pulse/
/home/.config/mozilla/
/home/.config/discord/

# No application binaries or unrelated user units.
/home/.local/bin/*
!/home/.local/bin/hyprstack-dim
!/home/.local/bin/caelestia-session-start
!/home/.local/bin/studio-mic-router
/home/.config/systemd/user/local-llm.service
